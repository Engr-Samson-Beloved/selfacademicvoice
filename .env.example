# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env

# --- Gemini (primary provider) ------------------------------------------------
# NOTE: llm.py reads GEMINI_API_SECRET and GEMINI_API_KEY2, in that order.
# A key set only as GEMINI_API_KEY is IGNORED. Set at least GEMINI_API_SECRET.
GEMINI_API_SECRET=
GEMINI_API_KEY2=

# Primary model. Others are tried in rotation on 404/500/503.
GEMINI_MODEL=gemini-3.7-flash
# Optional: override the whole rotation with a comma-separated list.
# GEMINI_MODELS=gemini-3.7-flash,gemini-3.6-flash

# --- Groq (fallback provider) -------------------------------------------------
# Optional. Without it, a Gemini outage fails the job instead of falling back.
GROQ_API_KEY=

# --- Rewrite engine -----------------------------------------------------------
GHOSTWRITER_PROVIDER=gemini
GHOSTWRITER_CHUNK_SIZE=8
GHOSTWRITER_MAX_WORKERS=4
GHOSTWRITER_TEMPERATURE=0.8
# Fraction of sentences kept verbatim. 0 rewrites every sentence.
GHOSTWRITER_KEEP_RATIO=0

# --- Voice gate ---------------------------------------------------------------
# Generated by: python -m ghostwriter.voiceprofile <corpus> -o data/style_prompt.txt
# If the profile file is absent the gate is skipped automatically.
GHOSTWRITER_VOICE_PROFILE=data/voice_profile.json
GHOSTWRITER_VOICE_GATE=1
GHOSTWRITER_VOICE_GATE_ATTEMPTS=2

# --- Server -------------------------------------------------------------------
PORT=8000
